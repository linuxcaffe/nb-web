# nb-web core — load-bearing identifiers
# These are the contracts that plugins and the UI depend on.
# Add a new line whenever you introduce a function that everything else calls.

# ── Plugin API (nbweb.js) ─────────────────────────────────────────────────────
nbweb.js:registerModule
nbweb.js:registerRenderer
nbweb.js:getPreviewRenderer
nbweb.js:getPreviewRenderers
nbweb.js:getRenderers
nbweb.js:getRendererTypes
nbweb.js:loadNotebookConfig
nbweb.js:bustNotebookConfigCache

# ── Render pipeline (main.js) ─────────────────────────────────────────────────
main.js:async function renderPreview
main.js:_enrichRendered
main.js:_finishRendered
main.js:_renderMarkdown
main.js:_resolveInlineQueries
main.js:_buildFmBlocks

# ── Shared display/rendering utilities exposed to satellites (main.js) ────────
# Load-bearing seam: showCmdOutput/showPreviewLoading called by sync.js via
# NbMain.*; parseMarkdownStatic called by plugins-page.js and templates.js via
# NbMain.* (also used bare by kernel renderPreview). runGrep/import (still in
# this file) call the bare private versions directly.
main.js:_showCmdOutput
main.js:_showPreviewLoading
main.js:_parseMarkdownStatic

# ── Notebooks-settings kernel-state accessor (main.js) ─────────────────────────
# Load-bearing seam: notebooks-page.js reads kernel-owned _nbSortMode through
# this -- kernel's own _bindSortBtn (Panel menus) also reads it for the shared
# #nb-sort-btn dropdown's active-item checkmarks, which serves the plain
# note-list sort too. The notebooks array itself and the sort/render logic are
# satellite-local (moved wholesale -- no other kernel code needed them).
main.js:getNbSortMode

# ── List-generation counter accessors (main.js) ────────────────────────────────
# Load-bearing seam: templates.js reads/checks kernel-owned _listSeq through
# these -- kernel's own loadNotes/search AND not-yet-extracted runCal/runGrep
# also increment/check the same counter, so it stays private behind these two
# intent-named operations rather than a raw get/set of the value itself.
main.js:bumpListSeq
main.js:isStaleListSeq

# ── Navigation (nav.js) ───────────────────────────────────────────────────────
nav.js:const NbNav
nav.js:_openSyncDialog
nav.js:activateCmd

# ── Terminal (terminal.js) ─────────────────────────────────────────────────────
terminal.js:const NbTerminal

# ── Folder dialog + file-ops tabs (dialog.js) ──────────────────────────────────
dialog.js:const NbDialog

# ── Drag handles (drag-handles.js) ─────────────────────────────────────────────
drag-handles.js:const NbDragHandles

# ── Note actions (note-actions.js) ─────────────────────────────────────────────
note-actions.js:const NbNoteActions

# ── Search (search.js) ─────────────────────────────────────────────────────────
search.js:const NbSearch

# ── Sync / run-command (sync.js) ───────────────────────────────────────────────
sync.js:const NbSync

# ── Plugins page (plugins-page.js) ─────────────────────────────────────────────
plugins-page.js:const NbPluginsPage

# ── Notebooks settings page (notebooks-page.js) ─────────────────────────────────
notebooks-page.js:const NbNotebooksPage

# ── Templates view (templates.js) ──────────────────────────────────────────────
templates.js:const NbTemplates

# ── Flask backend (app.py) ────────────────────────────────────────────────────
app.py:def run_nb
app.py:def api_note
app.py:def api_edit_note
app.py:def api_notes
app.py:def api_inline_query
app.py:def api_cine_data
